import cosas.*

describe "tests de cosas" {

  test "poner al embalaje residuos radioactivos" {
    embalajeDeSeguridad.cosa(residuosRadioactivos)
    embalajeDeSeguridad.pesoActual()
    assert.equals(30, embalajeDeSeguridad.pesoActual())
  }
  test "poner al contenedor cosas" {
    contenedorPotuario.cosas = [knightRider, arenaGranel, bateriaAntiaerea]
    arenaGranel.pesoActual(10)   //PESO NO ESCRITO EN CONSIGNA
    bateriaAntiaerea.hayMisiles(false)
    contenedorPotuario.pesoActual()
    assert.equals(810, contenedorPotuario.pesoActual())
  }

}
